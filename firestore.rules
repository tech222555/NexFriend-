rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        // Allow updating specific keys if they are valid
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'username', 'gender', 'age', 'country', 'city', 
          'interests', 'profilePicture', 'bio', 'lastActive', 'preferences',
          'uid', 'email', 'badges', 'createdAt'
        ]) &&
        // Ensure critical fields don't change
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        // Minimum age requirement
        (incoming().age == null || (incoming().age is number && incoming().age >= 13))
      );
    }

    function isValidUser(data) {
      return ('fullName' in data) && (data.fullName is string) && (data.fullName.size() <= 120) &&
             ('username' in data) && (data.username is string) && (data.username.size() <= 50) &&
             ('email' in data) && (data.email is string) && (data.email.size() <= 120);
    }

    // Match Rules
    match /matches/{matchId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn() && (
        request.auth.uid in incoming().userIds &&
        (
          (incoming().userIds.size() == 2 && incoming().status == 'pending') ||
          (incoming().isGroup == true && incoming().userIds.size() >= 1 && incoming().createdBy == request.auth.uid)
        )
      );
      allow update: if isSignedIn() && 
                    request.auth.uid in existing().userIds && 
                    (!('userIds' in incoming()) || 
                     incoming().userIds == existing().userIds || 
                     (existing().isGroup == true && request.auth.uid in existing().userIds));

      // Message Rules (Sub-collection)
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds;
        allow create: if isSignedIn() && 
                      (!exists(/databases/$(database)/documents/matches/$(matchId)) || 
                       request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds) &&
                      (incoming().senderId == request.auth.uid || incoming().senderId == 'system') &&
                      incoming().text is string && incoming().text.size() <= 1100000 &&
                      (!('senderName' in incoming()) || (incoming().senderName is string && incoming().senderName.size() <= 120)) &&
                      (!('audioUrl' in incoming()) || (incoming().audioUrl is string && incoming().audioUrl.size() <= 1100000)) &&
                      (!('imageUrl' in incoming()) || (incoming().imageUrl is string && incoming().imageUrl.size() <= 1100000)) &&
                      (!('fileUrl' in incoming()) || (incoming().fileUrl is string && incoming().fileUrl.size() <= 1100000)) &&
                      (!('fileName' in incoming()) || (incoming().fileName is string && incoming().fileName.size() <= 256)) &&
                      (!('fileSize' in incoming()) || (incoming().fileSize is string && incoming().fileSize.size() <= 50)) &&
                      (!('mediaType' in incoming()) || (incoming().mediaType is string && incoming().mediaType.size() <= 20)) &&
                      (!('reactions' in incoming()) || incoming().reactions is map);
        allow update: if isSignedIn() && 
                      request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds && (
                        (incoming().diff(existing()).affectedKeys().hasOnly(['read']) && incoming().read == true) ||
                        (incoming().diff(existing()).affectedKeys().hasOnly(['reactions']) && (incoming().reactions is map))
                      );
      }
    }

    // Notification Rules
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isSignedIn() && (
        isOwner(userId) || 
        incoming().matchId == 'status' ||
        // Allow creating notifications for matches
        (incoming().matchId != null && 
         exists(/databases/$(database)/documents/matches/$(incoming().matchId)) &&
         request.auth.uid in get(/databases/$(database)/documents/matches/$(incoming().matchId)).data.userIds &&
         userId in get(/databases/$(database)/documents/matches/$(incoming().matchId)).data.userIds)
      );
    }

    // Status Update Rules
    match /statuses/{statusId} {
      allow read, list: if isSignedIn() && request.auth.uid in resource.data.viewerIds;
      allow create: if isSignedIn() && 
                    incoming().userId == request.auth.uid &&
                    incoming().viewerIds is list;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
