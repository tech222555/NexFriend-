{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "age": { "type": "integer" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "interests": { "type": "array", "items": { "type": "string" } },
        "profilePicture": { "type": "string" },
        "bio": { "type": "string" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "preferences": {
          "type": "object",
          "properties": {
            "gender": { "type": "string", "enum": ["Male", "Female", "Other", "All"] },
            "ageRange": { "type": "array", "items": { "type": "integer" } }
          }
        }
      },
      "required": ["fullName", "username", "email", "gender", "age"]
    },
    "Match": {
      "title": "Match",
      "description": "A match between users or a group chat",
      "type": "object",
      "properties": {
        "userIds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "active", "unmatched"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "isGroup": { "type": "boolean" },
        "groupName": { "type": "string" },
        "groupIcon": { "type": "string" },
        "groupDescription": { "type": "string" },
        "createdBy": { "type": "string" },
        "admins": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Message": {
      "title": "Message",
      "description": "A message sent in a chat",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" },
        "translations": { "type": "object" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["match", "message", "friend_request"] },
        "fromUserId": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Status": {
      "title": "Status",
      "description": "WhatsApp-like User Status Updates",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userFullName": { "type": "string" },
        "userProfilePicture": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "video"] },
        "content": { "type": "string" },
        "bgGradient": { "type": "string" },
        "textColor": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "viewerIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["userId", "type", "content", "createdAt", "viewerIds"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Main user account profiles"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Matches between users"
    },
    "/matches/{matchId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages within a match"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notifications for a specific user"
    },
    "/statuses/{statusId}": {
      "schema": "Status",
      "description": "User shared stories/status updates with customized viewers"
    }
  }
}
